{
  "name": "Huly v0.7 All-in-One Team Workspace",
  "description": "Projects, chat and docs in one app. Open-source Linear + Slack alternative.",
  "category": "Other",
  "tags": [
    "huly",
    "project-management",
    "issue-tracker",
    "team-chat",
    "documents",
    "linear-alternative",
    "slack-alternative"
  ],
  "image": "https://cdn.jsdelivr.net/gh/hcengineering/platform@v0.7.426/dev/prod/public/huly/icon-256.png",
  "upstream": {
    "repo": "hcengineering/huly-selfhost",
    "version": "v0.7.426",
    "checked": "2026-10-11"
  },
  "services": {
    "proxy": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/caddy.svg",
      "source": {
        "repo": "baranberkay96/huly-railway",
        "rootDirectory": "/services/proxy"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/_healthz",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": null,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port Caddy listens on; Railway routes the public domain and its healthcheck here.",
          "required": false
        },
        "FRONT_HOST": {
          "defaultValue": "${{front.RAILWAY_PRIVATE_DOMAIN}}:8080",
          "description": "Front server.",
          "required": false
        },
        "ACCOUNT_HOST": {
          "defaultValue": "${{account.RAILWAY_PRIVATE_DOMAIN}}:3000",
          "description": "Account service (/_accounts).",
          "required": false
        },
        "TRANSACTOR_HOST": {
          "defaultValue": "${{transactor.RAILWAY_PRIVATE_DOMAIN}}:3333",
          "description": "Transactor (/_transactor and /eyJ… websockets).",
          "required": false
        },
        "COLLABORATOR_HOST": {
          "defaultValue": "${{collaborator.RAILWAY_PRIVATE_DOMAIN}}:3078",
          "description": "Collaborator (/_collaborator).",
          "required": false
        },
        "REKONI_HOST": {
          "defaultValue": "${{rekoni.RAILWAY_PRIVATE_DOMAIN}}:4004",
          "description": "Rekoni (/_rekoni).",
          "required": false
        },
        "STATS_HOST": {
          "defaultValue": "${{stats.RAILWAY_PRIVATE_DOMAIN}}:4900",
          "description": "Stats (/_stats).",
          "required": false
        },
        "PULSE_HOST": {
          "defaultValue": "${{hulypulse.RAILWAY_PRIVATE_DOMAIN}}:8099",
          "description": "HulyPulse (/_pulse -> /ws).",
          "required": false
        },
        "MAX_UPLOAD_SIZE": {
          "defaultValue": "100MB",
          "description": "Maximum request body (upstream nginx: 100M).",
          "required": false
        }
      }
    },
    "front": {
      "icon": "https://cdn.jsdelivr.net/gh/hcengineering/platform@v0.7.426/dev/prod/public/huly/icon-256.png",
      "source": {
        "image": "hardcoreeng/front:v0.7.426"
      },
      "startCommand": "/bin/sh -c 'q() { node -p \"encodeURIComponent(process.argv[1])\" \"$1\"; }; export STORAGE_CONFIG=\"s3|$S3_ENDPOINT?accessKey=$(q \"$S3_ACCESS_KEY\")&secretKey=$(q \"$S3_SECRET_KEY\")&region=$(q \"$S3_REGION\")&rootBucket=$(q \"$S3_BUCKET\")&allowPresign=false\"; exec node ./bundle.js'",
      "preDeployCommand": null,
      "healthcheckPath": "/",
      "healthcheckTimeout": 900,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": null,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port the front server listens on; Railway's healthcheck probes it.",
          "required": false
        },
        "SERVER_PORT": {
          "defaultValue": "8080",
          "description": "Front server port.",
          "required": false
        },
        "SERVER_SECRET": {
          "defaultValue": "${{transactor.SERVER_SECRET}}",
          "description": "Shared Huly server secret (signs tokens between services).",
          "required": false
        },
        "ACCOUNTS_URL": {
          "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}/_accounts",
          "description": "Public account service URL (used by browsers).",
          "required": false
        },
        "ACCOUNTS_URL_INTERNAL": {
          "defaultValue": "http://${{account.RAILWAY_PRIVATE_DOMAIN}}:3000",
          "description": "Account service (private network).",
          "required": false
        },
        "REKONI_URL": {
          "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}/_rekoni",
          "description": "Public Rekoni URL.",
          "required": false
        },
        "CALENDAR_URL": {
          "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}/_calendar",
          "description": "Calendar integration URL (service not included; as upstream).",
          "required": false
        },
        "GMAIL_URL": {
          "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}/_gmail",
          "description": "Gmail integration URL (service not included; as upstream).",
          "required": false
        },
        "TELEGRAM_URL": {
          "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}/_telegram",
          "description": "Telegram integration URL (service not included; as upstream).",
          "required": false
        },
        "STATS_URL": {
          "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}/_stats",
          "description": "Public stats URL.",
          "required": false
        },
        "UPLOAD_URL": {
          "defaultValue": "/files",
          "description": "Upload path served by front.",
          "required": false
        },
        "ELASTIC_URL": {
          "defaultValue": "http://elastic:${{elastic.ELASTIC_PASSWORD}}@${{elastic.RAILWAY_PRIVATE_DOMAIN}}:9200",
          "description": "Elasticsearch (private network).",
          "required": false
        },
        "COLLABORATOR_URL": {
          "defaultValue": "wss://${{proxy.RAILWAY_PUBLIC_DOMAIN}}/_collaborator",
          "description": "Public collaborator websocket URL.",
          "required": false
        },
        "PULSE_URL": {
          "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}/_pulse",
          "description": "Public HulyPulse URL.",
          "required": false
        },
        "TITLE": {
          "defaultValue": "Huly",
          "description": "Browser title of your instance.",
          "required": false
        },
        "DEFAULT_LANGUAGE": {
          "defaultValue": "en",
          "description": "Default UI language.",
          "required": false
        },
        "LAST_NAME_FIRST": {
          "defaultValue": "true",
          "description": "Show people as 'Last First' (upstream default).",
          "required": false
        },
        "DESKTOP_UPDATES_CHANNEL": {
          "defaultValue": "0.7.426",
          "description": "Desktop app update channel; keep equal to the server version without 'v'.",
          "required": false
        },
        "DISABLED_FEATURES": {
          "defaultValue": "auto-translate,mailboxes",
          "description": "Features that need services not included (as upstream).",
          "required": false
        },
        "DISABLE_SIGNUP": {
          "defaultValue": "${{account.DISABLE_SIGNUP}}",
          "description": "Hide the sign-up form (follows the account service).",
          "required": false
        },
        "S3_ENDPOINT": {
          "defaultValue": "${{Bucket.ENDPOINT}}",
          "description": "Railway Bucket S3 endpoint; the start command builds Huly's STORAGE_CONFIG from the S3_* variables (URL-encoded).",
          "required": false
        },
        "S3_ACCESS_KEY": {
          "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
          "description": "Bucket access key.",
          "required": false
        },
        "S3_SECRET_KEY": {
          "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
          "description": "Bucket secret key.",
          "required": false
        },
        "S3_BUCKET": {
          "defaultValue": "${{Bucket.BUCKET}}",
          "description": "Bucket name; every workspace is a folder in it (rootBucket).",
          "required": false
        },
        "S3_REGION": {
          "defaultValue": "${{Bucket.REGION}}",
          "description": "Bucket region.",
          "required": false
        }
      }
